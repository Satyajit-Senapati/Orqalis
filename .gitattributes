* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Preserve intentional Markdown hard breaks in the supplied signed-off baseline.
SIGNOFF.md whitespace=-blank-at-eol

# Retain the exact captured bytes used by the release evidence hash chains.
# Runtime/source text still uses the LF rules above.
docs/quality/evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Generated captures are reviewable but collapsed by default in GitHub diffs.
docs/quality/evidence/** linguist-generated=true
/.gitattributes text eol=lf
