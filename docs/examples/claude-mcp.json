{
  "mcpServers": {
    "orqalis": {
      "type": "stdio",
      "command": "/absolute/path/to/node",
      "args": [
        "/absolute/global-node-modules/orqalis/bin/orqalis.js",
        "mcp",
        "--policy",
        "/absolute/path/to/mcp-policy.json",
        "--root",
        "/absolute/path/to/repository"
      ]
    }
  }
}
